#!/usr/bin/env bash
# Regenerate the TypeScript SDK with the vendored STLC CLI bundle (vendor/stlc/dist).
#
# Prerequisites:
#   - specs/internal_openapi_spec.json is up to date (copy from augno/api or run make openapi there).
#   - stainless/stainless.yml is the canonical internal config (synced from api/stainless/internal when it changes).
#
# STLC resolves output as: <parent-of-this-repo>/<repo-name-from-staging_repo>, e.g. core/internal-sdk
# under the augno monorepo. Pass explicit --output via STLC_PARENT_DIR if needed.
#
# Dirty tree: stlc requires --commit unless the working tree is clean. Either commit/reset manually,
# or set STLC_CODEGEN_COMMIT=1 to pass --commit (stlc will git add/commit all unstaged changes).
#
# Environment overrides:
#   STLC_PARENT_DIR     — defaults to dirname(repo root); directory such that joining "internal-sdk" yields this repo.
#   STLC_TARGETS        — default "typescript"
#   STLC_BRANCH         — branch metadata for build (defaults to current git branch, else main)
#   STLC_CODEGEN_COMMIT — set to 1 to append --commit
#   STLC_CODEGEN_COMMIT_MESSAGE — commit message when STLC_CODEGEN_COMMIT=1

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STLC_CLI="$ROOT/vendor/stlc/dist/index.cjs"
PARENT="${STLC_PARENT_DIR:-$(dirname "$ROOT")}"
WS_JSON="$ROOT/stainless/workspace.json"

if [ ! -f "$STLC_CLI" ]; then
  echo "scripts/codegen: missing STLC CLI at vendor/stlc/dist/index.cjs" >&2
  exit 1
fi

if [ ! -f "$WS_JSON" ]; then
  echo "scripts/codegen: missing $WS_JSON" >&2
  exit 1
fi

COMMIT_MSG="${STLC_CODEGEN_COMMIT_MESSAGE:-chore(codegen): regenerate SDK via stlc}"

DIRTY=""
if [ -d "$ROOT/.git" ]; then
  DIRTY="$(git -C "$ROOT" status --porcelain 2>/dev/null || true)"
fi

if [ -n "$DIRTY" ] && [ "${STLC_CODEGEN_COMMIT:-}" != "1" ]; then
  echo "scripts/codegen: working tree is dirty. Commit/reset changes, or re-run with STLC_CODEGEN_COMMIT=1 ." >&2
  exit 1
fi

BRANCH="${STLC_BRANCH:-}"
if [ -z "$BRANCH" ] && [ -d "$ROOT/.git" ]; then
  BRANCH="$(git -C "$ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
fi
if [ -z "$BRANCH" ] || [ "$BRANCH" = HEAD ]; then
  BRANCH="${STLC_BRANCH_FALLBACK:-main}"
fi

TARGETS="${STLC_TARGETS:-typescript}"

# macOS Bash 3.2 + `set -u`: expanding "${EXTRA[@]}" on an empty array is an error (“unbound variable”).
if [ -n "$DIRTY" ] && [ "${STLC_CODEGEN_COMMIT:-}" = "1" ]; then
  exec node "$STLC_CLI" build \
    --workspace "$WS_JSON" \
    --output "$PARENT" \
    --targets "$TARGETS" \
    --branch "$BRANCH" \
    --commit "$COMMIT_MSG"
fi

exec node "$STLC_CLI" build \
  --workspace "$WS_JSON" \
  --output "$PARENT" \
  --targets "$TARGETS" \
  --branch "$BRANCH"
