#!/usr/bin/env bash
# Regenerate the TypeScript SDK with the STLC CLI.
#
# The CLI must exist at ONE of:
#   - INTERNAL_SDK_STLC_CLI (absolute path)
#   - vendor/stlc/dist/index.cjs (vendored bundle)
#   - ../stlc-main/packages/stlc/dist/index.cjs (sibling mono checkout)
#
# Working tree must be clean, or STLC_CODEGEN_COMMIT=1 (invokes `stlc build --commit`).

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WS_JSON="$ROOT/stainless/workspace.json"

COMMIT_MSG="${STLC_CODEGEN_COMMIT_MESSAGE:-chore(codegen): regenerate SDK via stlc}"

resolve_stlc_cli() {
	if [ "${INTERNAL_SDK_STLC_CLI:-}" != "" ]; then
		echo "$INTERNAL_SDK_STLC_CLI"
		return
	fi
	if [ -f "$ROOT/vendor/stlc/dist/index.cjs" ]; then
		echo "$ROOT/vendor/stlc/dist/index.cjs"
		return
	fi
	if [ -f "$ROOT/../stlc-main/packages/stlc/dist/index.cjs" ]; then
		echo "$ROOT/../stlc-main/packages/stlc/dist/index.cjs"
		return
	fi
	echo ""
}

STLC_CLI="$(resolve_stlc_cli)"
if [ -z "$STLC_CLI" ]; then
	echo "scripts/codegen: STLC CLI not found. Set INTERNAL_SDK_STLC_CLI, vendor vendor/stlc/dist, or checkout stlc-main next to internal-sdk." >&2
	exit 1
fi

if [ ! -f "$WS_JSON" ]; then
	echo "scripts/codegen: missing $WS_JSON" >&2
	exit 1
fi

OPENAPI_SPEC="$ROOT/specs/internal_openapi_spec.json"
if [ ! -f "$OPENAPI_SPEC" ]; then
	api_spec="$(dirname "$ROOT")/api/specs/internal_openapi_spec.json"
	echo "scripts/codegen: missing OpenAPI spec: $OPENAPI_SPEC" >&2
	if [ -f "$api_spec" ]; then
		echo "  Sibling api checkout found — run:" >&2
		echo "  mkdir -p \"$(dirname "$OPENAPI_SPEC")\" && cp \"$api_spec\" \"$OPENAPI_SPEC\"" >&2
	fi
	exit 1
fi

DIRTY=""
if [ -d "$ROOT/.git" ]; then
	DIRTY="$(git -C "$ROOT" status --porcelain 2>/dev/null || true)"
fi

if [ -n "$DIRTY" ] && [ "${STLC_CODEGEN_COMMIT:-}" != "1" ]; then
	echo "scripts/codegen: working tree is dirty. Commit/reset changes, or re-run with STLC_CODEGEN_COMMIT=1 ." >&2
	exit 1
fi

PARENT="${STLC_PARENT_DIR:-$(dirname "$ROOT")}"

BRANCH="${STLC_BRANCH:-}"
if [ -z "$BRANCH" ] && [ -d "$ROOT/.git" ]; then
	BRANCH="$(git -C "$ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
fi
if [ -z "$BRANCH" ] || [ "$BRANCH" = HEAD ]; then
	BRANCH="${STLC_BRANCH_FALLBACK:-main}"
fi

TARGETS="${STLC_TARGETS:-typescript}"

if [ -n "$DIRTY" ] && [ "${STLC_CODEGEN_COMMIT:-}" = "1" ]; then
	exec node "$STLC_CLI" build \
		--workspace "$WS_JSON" \
		--output "$PARENT" \
		--targets "$TARGETS" \
		--branch "$BRANCH" \
		--commit "$COMMIT_MSG"
fi

exec node "$STLC_CLI" build \
	--workspace "$WS_JSON" \
	--output "$PARENT" \
	--targets "$TARGETS" \
	--branch "$BRANCH"
