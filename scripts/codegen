#!/usr/bin/env bash
# Regenerate the TypeScript SDK with STLC (`stlc build`).
#
# OpenAPI spec resolution (first match wins):
#   1) INTERNAL_SDK_OPENAPI_SPEC — absolute path (or cwd-relative; use absolute in CI)
#   2) <parent-of-internal-sdk>/api/specs/internal_openapi_spec.json — augno monorepo
#   3) specs/internal_openapi_spec.json — standalone clone
#
# Defaulting to (2) avoids keeping a copy under this repo: `stlc` runs `git clean` during
# integration, which deletes *untracked* files in the SDK repo—including specs/ if the
# JSON was never committed.
#
# STLC CLI (first match):
#   INTERNAL_SDK_STLC_CLI, vendor/stlc/dist/index.cjs, ../stlc-main/packages/stlc/dist/index.cjs
#
# Clean git tree required unless STLC_CODEGEN_COMMIT=1 (passes --commit to stlc).

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WS_JSON="$ROOT/stainless/workspace.json"
MONO_API_SPEC="$(dirname "$ROOT")/api/specs/internal_openapi_spec.json"
LOCAL_SPEC="$ROOT/specs/internal_openapi_spec.json"

COMMIT_MSG="${STLC_CODEGEN_COMMIT_MESSAGE:-chore(codegen): regenerate SDK via stlc}"

resolve_stlc_cli() {
	if [ "${INTERNAL_SDK_STLC_CLI:-}" != "" ]; then
		echo "$INTERNAL_SDK_STLC_CLI"
		return
	fi
	if [ -f "$ROOT/vendor/stlc/dist/index.cjs" ]; then
		echo "$ROOT/vendor/stlc/dist/index.cjs"
		return
	fi
	if [ -f "$ROOT/../stlc-main/packages/stlc/dist/index.cjs" ]; then
		echo "$ROOT/../stlc-main/packages/stlc/dist/index.cjs"
		return
	fi
	echo ""
}

resolve_openapi_spec() {
	if [ "${INTERNAL_SDK_OPENAPI_SPEC:-}" != "" ]; then
		echo "${INTERNAL_SDK_OPENAPI_SPEC}"
		return
	fi
	if [ -f "$MONO_API_SPEC" ]; then
		echo "$MONO_API_SPEC"
		return
	fi
	echo "$LOCAL_SPEC"
}

STLC_CLI="$(resolve_stlc_cli)"
if [ -z "$STLC_CLI" ]; then
	echo "scripts/codegen: STLC CLI not found. Set INTERNAL_SDK_STLC_CLI, vendor vendor/stlc/dist, or checkout stlc-main next to internal-sdk." >&2
	exit 1
fi

if [ ! -f "$WS_JSON" ]; then
	echo "scripts/codegen: missing $WS_JSON" >&2
	exit 1
fi

SPEC="$(resolve_openapi_spec)"
if [ ! -f "$SPEC" ]; then
	echo "scripts/codegen: OpenAPI spec not found (tried INTERNAL_SDK_OPENAPI_SPEC, then \"$MONO_API_SPEC\", then \"$LOCAL_SPEC\")." >&2
	exit 1
fi

DIRTY=""
if [ -d "$ROOT/.git" ]; then
	DIRTY="$(git -C "$ROOT" status --porcelain 2>/dev/null || true)"
fi

if [ -n "$DIRTY" ] && [ "${STLC_CODEGEN_COMMIT:-}" != "1" ]; then
	echo "scripts/codegen: working tree is dirty. Commit/reset changes, or re-run with STLC_CODEGEN_COMMIT=1 ." >&2
	exit 1
fi

PARENT="${STLC_PARENT_DIR:-$(dirname "$ROOT")}"

BRANCH="${STLC_BRANCH:-}"
if [ -z "$BRANCH" ] && [ -d "$ROOT/.git" ]; then
	BRANCH="$(git -C "$ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
fi
if [ -z "$BRANCH" ] || [ "$BRANCH" = HEAD ]; then
	BRANCH="${STLC_BRANCH_FALLBACK:-main}"
fi

TARGETS="${STLC_TARGETS:-typescript}"

if [ -n "$DIRTY" ] && [ "${STLC_CODEGEN_COMMIT:-}" = "1" ]; then
	exec node "$STLC_CLI" build \
		--workspace "$WS_JSON" \
		--spec "$SPEC" \
		--output "$PARENT" \
		--targets "$TARGETS" \
		--branch "$BRANCH" \
		--commit "$COMMIT_MSG"
fi

exec node "$STLC_CLI" build \
	--workspace "$WS_JSON" \
	--spec "$SPEC" \
	--output "$PARENT" \
	--targets "$TARGETS" \
	--branch "$BRANCH"
